# Copy to .env and fill in. Read by django-environ at startup.
DB_NAME=vid_search
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Hugging Face token for pyannote speaker diarization (gated models).
# Accept the terms for pyannote/speaker-diarization-3.1 AND
# pyannote/segmentation-3.0 on huggingface.co first.
HF_TOKEN=

# Monthly free-tier transcription allowance per logged-in user, in minutes.
FREE_TIER_MINUTES=60

# Requests per minute per caller (user, or IP when anonymous); 0 disables.
RATE_LIMIT_SEARCH_PER_MIN=60
RATE_LIMIT_INGEST_PER_MIN=10
